# EmailJS (contact form). Copy this file to .env and fill in the values.
# These are bundled into the browser build, so use EmailJS's *public* key only.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: point the Resume button at an external document instead of
# public/resume/Praise-Adeogun-Resume.pdf
VITE_RESUME_URL=
